# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

# Cloudflare R2 (opcional em dev — uploads ficam desabilitados sem isso)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fht-documentos
R2_PUBLIC_URL=

# Chaves JWT em base64 (JWT_PUBLIC_KEY / JWT_PRIVATE_KEY): o setup.sh acrescenta aqui sozinho.
