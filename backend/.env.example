# Banco — docker compose / dev local
DB_HOST=localhost
DB_PORT=5433
DB_NAME=fht_db
DB_USER=fht_user
DB_PASS=fht_pass
# Banco — produção (Render + Neon). Se DATABASE_URL estiver definida, ela vence as DB_* acima.
# DATABASE_URL=jdbc:postgresql://ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_USER=neondb_owner
# DATABASE_PASSWORD=...

# Chaves JWT: o .pem INTEIRO em base64, numa linha só (o setup.sh da raiz gera pra você):
#   openssl base64 -A -in src/main/resources/publicKey.pem
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

# CORS (lista separada por vírgula) — em produção, a URL do site no Cloudflare Pages
CORS_ORIGINS=http://localhost:5173

# Porta HTTP (o Render injeta a dele)
PORT=8080

# Cloudflare R2
R2_ACCOUNT_ID=seu_account_id
R2_ACCESS_KEY_ID=sua_access_key
R2_SECRET_ACCESS_KEY=sua_secret_key
R2_BUCKET=fht-documentos
R2_PUBLIC_URL=https://pub.seu-dominio.com

# E-mail (simulado por padrão — aparece no log e não sai)
SMTP_MOCK=true

# Senha do primeiro ADMIN_FHT: obrigatória em prod (sem ela a app não sobe). A V2 usa uma vez e grava só o hash.
FHT_ADMIN_SENHA=
